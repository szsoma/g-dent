---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  exteriorImage: ImageMetadata;
  exteriorImageAlt: string;
  eyebrow: string;
  heading: string;
  intro: string;
  phoneLabel: string;
  phoneHref: string;
  emailLabel: string;
  emailHref: string;
  addressLabel: string;
  addressValue: string;
  hoursLabel: string;
  hoursValue: string[];
  imageCaption: string;
}

const {
  exteriorImage,
  exteriorImageAlt,
  eyebrow,
  heading,
  intro,
  phoneLabel,
  phoneHref,
  emailLabel,
  emailHref,
  addressLabel,
  addressValue,
  hoursLabel,
  hoursValue,
  imageCaption,
}: Props = Astro.props;
---

<section id="kapcsolat" class="relative overflow-hidden bg-primary text-on-primary">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(110% 80% at 12% 92%, color-mix(in srgb, #ffffff 6%, transparent) 0%, transparent 55%)"
  >
  </div>
  <div class="container-page relative py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
      <div class="reveal">
        <p class="eyebrow text-on-primary/70">{eyebrow}</p>
        <h2 class="mt-4 font-display text-h2 leading-tight">{heading}</h2>
        <p class="mt-5 max-w-lg text-lead text-on-primary/80">{intro}</p>

        <div class="mt-9 flex flex-col gap-4">
          <a
            href={phoneHref}
            class="group inline-flex w-fit items-center gap-3 rounded-xs bg-canvas px-7 py-4 text-[1.0625rem] font-medium text-primary shadow-lift transition-all duration-300 ease-[var(--ease-soft)] hover:shadow-pill"
          >
            <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
              <path
                d="M6.6 3.5h2.3l1.6 4-2 1.4a11 11 0 0 0 5.6 5.6l1.4-2 4 1.6v2.3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
            </svg>
            {phoneLabel}
          </a>
          <a
            href={emailHref}
            class="inline-flex w-fit items-center gap-3 text-lead text-on-primary underline decoration-on-primary/40 decoration-1 underline-offset-[6px] transition-colors duration-300 hover:decoration-on-primary"
          >
            {emailLabel}
          </a>
        </div>

        <dl class="mt-12 grid gap-6 border-t border-on-primary/25 pt-8 sm:grid-cols-2">
          <div>
            <dt class="eyebrow text-on-primary/55">{addressLabel}</dt>
            <dd class="mt-2 text-body leading-relaxed">{addressValue}</dd>
          </div>
          <div>
            <dt class="eyebrow text-on-primary/55">{hoursLabel}</dt>
            <dd class="mt-2 text-body leading-relaxed">
              {hoursValue.map((line) => <>{line}<br /></>)}
            </dd>
          </div>
        </dl>
      </div>

      <figure class="reveal relative" style="--reveal-delay: 140ms">
        <Image
          src={exteriorImage}
          alt={exteriorImageAlt}
          widths={[exteriorImage.width, 960]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="relative aspect-3/2 w-full object-cover shadow-pill"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-4 text-caption text-on-primary/70">{imageCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>
