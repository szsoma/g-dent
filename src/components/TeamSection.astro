---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Doctor {
  name: string;
  role: string;
  description: string;
  phone: string;
  phoneHref: string;
  email?: string;
  focus: string[];
}

interface Props {
  teamImage: ImageMetadata;
  teamImageAlt: string;
  eyebrow: string;
  heading: string;
  imageCaption: string;
  doctors: Doctor[];
}

const { teamImage, teamImageAlt, eyebrow, heading, imageCaption, doctors }: Props =
  Astro.props;
---

<section id="orvosaink" class="bg-surface py-16 md:py-20">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <figure class="reveal relative">
        <Image
          src={teamImage}
          alt={teamImageAlt}
          widths={[teamImage.width, 960]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="aspect-4/3 w-full object-cover shadow-pill"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-4 text-caption text-muted">{imageCaption}</figcaption>
      </figure>

      <div>
        <p class="reveal eyebrow text-terracotta">{eyebrow}</p>
        <h2 class="reveal mt-4 font-display text-h2 leading-tight" style="--reveal-delay: 80ms">
          {heading}
        </h2>

        <div class="mt-10 flex flex-col gap-10">
          {
            doctors.map((doctor, i) => (
              <article
                class="reveal border-t border-ink/15 pt-8"
                style={`--reveal-delay: ${(i + 2) * 90}ms`}
              >
                <h3 class="font-display text-[1.375rem] leading-tight">
                  {doctor.name}
                </h3>
                <p class="mt-1.5 eyebrow text-primary">{doctor.role}</p>
                <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ink/85">
                  {doctor.description}
                </p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {doctor.focus.map((chip) => (
                    <li class="rounded-full bg-canvas px-3 py-1.5 text-caption text-primary shadow-lift">
                      {chip}
                    </li>
                  ))}
                </ul>
                <p class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-body">
                  <a
                    href={doctor.phoneHref}
                    class="inline-flex items-center gap-2 text-primary transition-opacity duration-300 hover:opacity-70"
                  >
                    <svg viewBox="0 0 24 24" fill="none" class="size-4" aria-hidden="true">
                      <path
                        d="M6.6 3.5h2.3l1.6 4-2 1.4a11 11 0 0 0 5.6 5.6l1.4-2 4 1.6v2.3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {doctor.phone}
                  </a>
                  {doctor.email ? (
                    <a
                      href={`mailto:${doctor.email}`}
                      class="text-ink/70 transition-colors duration-300 hover:text-primary"
                    >
                      {doctor.email}
                    </a>
                  ) : null}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
