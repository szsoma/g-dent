---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Fact {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  heroImage: ImageMetadata;
  heroAlt: string;
  sideImage: ImageMetadata;
  sideImageAlt: string;
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  headingEnd: string;
  lead: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  facts: Fact[];
  namePlate: string;
  imageSideCaption: string;
}

const {
  heroImage,
  heroAlt,
  sideImage,
  sideImageAlt,
  eyebrow,
  headingLead,
  headingAccent,
  headingEnd,
  lead,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  facts,
  namePlate,
  imageSideCaption,
}: Props = Astro.props;
---

<section class="relative overflow-hidden bg-primary text-on-primary">
  <!-- Decorative plum-to-deep wash: flat surface with a whisper of depth -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-90"
    style="background: radial-gradient(120% 90% at 82% 8%, color-mix(in srgb, #ffffff 7%, transparent) 0%, transparent 55%)"
  >
  </div>

  <div class="container-page relative pt-36 pb-20 md:pt-44 md:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="max-w-2xl">
        <p class="reveal eyebrow flex items-center gap-3 text-on-primary/75">
          <span class="inline-block size-1.5 rounded-full bg-terracotta"></span>
          {eyebrow}
        </p>

        <h1 class="reveal mt-6 font-display text-[2.75rem] font-light md:text-hero lg:text-[3.25rem]" style="--reveal-delay: 90ms">
          {headingLead} <em class="font-normal">{headingAccent}</em>{headingEnd}
        </h1>

        <p class="reveal mt-7 max-w-xl text-lead text-on-primary/85" style="--reveal-delay: 180ms">
          {lead}
        </p>

        <div class="reveal mt-9 flex flex-wrap items-center gap-4" style="--reveal-delay: 260ms">
          <a
            href={primaryCtaHref}
            class="inline-flex items-center gap-2.5 rounded-xs bg-canvas px-6 py-3.5 text-body font-medium text-primary shadow-lift transition-all duration-300 ease-[var(--ease-soft)] hover:bg-canvas/88 hover:shadow-pill"
          >
            <svg viewBox="0 0 24 24" fill="none" class="size-4" aria-hidden="true">
              <path
                d="M6.6 3.5h2.3l1.6 4-2 1.4a11 11 0 0 0 5.6 5.6l1.4-2 4 1.6v2.3a2 2 0 0 1-2.2 2A16.8 16.8 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
            </svg>
            {primaryCtaLabel}
          </a>
          <a
            href="#szolgaltatasok"
            class="group inline-flex items-center gap-2 rounded-xs border border-on-primary/30 px-6 py-3.5 text-body text-on-primary transition-colors duration-300 hover:border-on-primary/60 hover:bg-on-primary/8"
          >
            {secondaryCtaLabel}
            <span class="transition-transform duration-300 ease-[var(--ease-soft)] group-hover:translate-x-1">→</span>
          </a>
        </div>

        <dl
          class="reveal mt-12 grid max-w-lg grid-cols-2 gap-x-8 gap-y-5 border-t border-on-primary/20 pt-8 text-caption sm:grid-cols-3"
          style="--reveal-delay: 340ms"
        >
          {
            facts.map((fact) => (
              <div>
                <dt class="text-on-primary/55">{fact.label}</dt>
                <dd class="mt-1 text-body">
                  {fact.href ? (
                    <a href={fact.href} class="hover:underline">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="reveal relative mx-auto w-full max-w-lg lg:max-none" style="--reveal-delay: 220ms">
        <!-- offset hairline frame -->
        <div
          aria-hidden="true"
          class="absolute -right-3 -bottom-3 hidden h-full w-full border border-on-primary/35 sm:block"
        >
        </div>
        <Image
          src={heroImage}
          alt={heroAlt}
          widths={[heroImage.width, 720]}
          sizes="(min-width: 1024px) 46vw, 92vw"
          class="relative aspect-4/5 w-full object-cover shadow-pill lg:aspect-3/4"
          loading="eager"
          decoding="async"
        />
        <figure class="absolute -bottom-10 -left-4 w-44 shadow-pill sm:-left-10 lg:w-48">
          <Image
            src={sideImage}
            alt={sideImageAlt}
            widths={[480, 640]}
            sizes="200px"
            class="aspect-square w-full border-4 border-primary object-cover"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="sr-only">{imageSideCaption}</figcaption>
        </figure>
        <p
          class="mt-14 inline-flex rounded-full bg-canvas px-4 py-2 text-caption text-primary shadow-lift lg:absolute lg:-right-6 lg:-bottom-4 lg:mt-0 lg:shadow-pill"
        >
          {namePlate}
        </p>
      </div>
    </div>
  </div>
</section>
