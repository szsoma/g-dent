---
import Wordmark from './Wordmark.astro';

interface FooterLink {
  label: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Props {
  text: string;
  tagline: string;
  description: string;
  sitemapTitle: string;
  contactTitle: string;
  navLinks: FooterLink[];
  contactLinks: FooterLink[];
  copyright: string;
  contactLine: string;
  homeLabel: string;
}

const {
  text,
  tagline,
  description,
  sitemapTitle,
  contactTitle,
  navLinks,
  contactLinks,
  copyright,
  contactLine,
  homeLabel,
}: Props = Astro.props;

const columns: FooterColumn[] = [
  { title: sitemapTitle, links: navLinks },
  { title: contactTitle, links: contactLinks },
];
---

<footer class="border-t border-ink/15 bg-canvas py-12">
  <div class="container-page">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <Wordmark {text} {tagline} {homeLabel} />
        <p class="mt-4 text-caption leading-relaxed text-muted">{description}</p>
      </div>

      {
        columns.map((column) => (
          <div>
            <p class="eyebrow text-muted">{column.title}</p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.9375rem] text-ink/80 transition-colors duration-300 hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-ink/15 pt-6 text-caption text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>{copyright}</p>
      <p>{contactLine}</p>
    </div>
  </div>
</footer>
